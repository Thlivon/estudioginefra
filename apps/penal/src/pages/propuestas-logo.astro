---
// TEMPORAL (hito 4): comparación de las 3 propuestas de logo para que el estudio elija. Borrar al elegir.
import '@ginefra/ui/estilos/penal.css';
import '@ginefra/ui/estilos/base.css';
import P1H from '@ginefra/ui/marca/propuesta-1-horizontal.svg';
import P1S from '@ginefra/ui/marca/propuesta-1-simbolo.svg';
import P2H from '@ginefra/ui/marca/propuesta-2-horizontal.svg';
import P2S from '@ginefra/ui/marca/propuesta-2-simbolo.svg';
import P3H from '@ginefra/ui/marca/propuesta-3-horizontal.svg';
import P3S from '@ginefra/ui/marca/propuesta-3-simbolo.svg';

const propuestas = [
  { n: 1, nombre: 'Monograma', detalle: '"G" y "&" entrelazados en un marco rectangular fino.', H: P1H, S: P1S },
  { n: 2, nombre: 'Wordmark', detalle: '"GINEFRA" en versalitas espaciadas, filete y "& ASOCIADOS" chico. En uso provisorio en el header.', H: P2H, S: P2S },
  { n: 3, nombre: 'Columna', detalle: 'Columna de líneas finas (guiño a los tribunales) y wordmark.', H: P3H, S: P3S },
];
const fondos = [
  { clase: 'claro', nombre: 'Sobre papel' },
  { clase: 'oscuro', nombre: 'Sobre tinta' },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Propuestas de logo | Ginefra & Asociados</title>
  </head>
  <body>
    <main class="contenedor">
      <h1>Propuestas de logo</h1>
      <p class="intro">
        Tres direcciones para reemplazar el logo provisorio. Cada una tiene versión horizontal (header) y símbolo (favicon y
        espacios chicos). Se muestran en tamaño real de header (40 px de alto) y de favicon (32 y 16 px).
      </p>
      {
        propuestas.map(({ n, nombre, detalle, H, S }) => (
          <section aria-labelledby={`p${n}`}>
            <h2 id={`p${n}`}>
              {n}. {nombre}
            </h2>
            <p>{detalle}</p>
            <div class="fondos">
              {fondos.map((f) => (
                <figure class={f.clase}>
                  <div class="grande">
                    <H aria-hidden="true" />
                  </div>
                  <div class="fila">
                    <H class="header" aria-hidden="true" />
                    <S class="s48" aria-hidden="true" />
                    <S class="s32" aria-hidden="true" />
                    <S class="s16" aria-hidden="true" />
                  </div>
                  <figcaption>{f.nombre}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        ))
      }
    </main>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
  }
  main {
    padding-block: var(--esp-7);
    display: grid;
    gap: var(--esp-7);
  }
  h1,
  h2 {
    font-family: Georgia, serif;
  }
  .intro {
    max-width: var(--ancho-texto);
    color: var(--texto-suave);
  }
  section {
    display: grid;
    gap: var(--esp-3);
  }
  .fondos {
    display: grid;
    gap: var(--esp-4);
  }
  figure {
    display: grid;
    gap: var(--esp-5);
    padding: var(--esp-6);
    border: 1px solid var(--linea);
    border-radius: var(--radio-2);
  }
  .claro {
    background: var(--papel);
    color: var(--tinta);
  }
  .oscuro {
    background: var(--tinta);
    color: var(--papel);
  }
  .grande :global(svg) {
    height: 96px;
    width: auto;
    max-width: 100%;
  }
  .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-5);
  }
  .fila :global(.header) {
    height: 40px;
    width: auto;
  }
  .fila :global(.s48) {
    height: 48px;
    width: auto;
  }
  .fila :global(.s32) {
    height: 32px;
    width: auto;
  }
  .fila :global(.s16) {
    height: 16px;
    width: auto;
  }
  figcaption {
    font-size: var(--paso--1);
    opacity: 0.8;
  }
  @media (min-width: 60em) {
    .fondos {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
