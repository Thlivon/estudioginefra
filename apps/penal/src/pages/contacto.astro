---
import { getEntry } from 'astro:content';
import LayoutPenal from '../layouts/LayoutPenal.astro';
import PlantillaContacto from '@ginefra/ui/plantillas/PlantillaContacto.astro';
import { sitio } from '../sitio.mjs';

const pagina = (await getEntry('paginas', 'contacto'))!;
const { seo, mensajeWhatsapp } = pagina.data;
---

<LayoutPenal title={seo.title} description={seo.description} mensajeWhatsapp={mensajeWhatsapp}>
  <PlantillaContacto pagina={pagina} sitio={sitio} />
</LayoutPenal>
