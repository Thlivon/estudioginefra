---
// Esqueleto común: meta, canonical, noindex, fuentes, JSON-LD del estudio, Header, Footer, barra mobile y flotante.
// El tema (penal.css / amparos.css) lo importa cada app.
import '../estilos/base.css';
import { Font } from 'astro:assets';
import { analitica, indexar, sitioHermano } from '../site.mjs';
import { legalService } from '../schema.mjs';
import { estudio } from '../estudio.mjs';
import Sprite from './Sprite.astro';
import JsonLd from './JsonLd.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import BarraContactoMovil from './BarraContactoMovil.astro';
import BotonWhatsAppFlotante from './BotonWhatsAppFlotante.astro';

interface Props {
  title: string;
  description: string;
  /** Config del sitio (apps/{sitio}/src/sitio.mjs) */
  sitio: any;
  /** Áreas del sitio ordenadas, para header, footer y schema */
  areas?: { slug: string; titulo: string; tituloCorto: string }[];
  mensajeWhatsapp?: string;
  ordenCtas?: 'llamar-primero' | 'whatsapp-primero';
  noindex?: boolean;
  /** Nodos JSON-LD extra de la página */
  schema?: object[];
}

const { title, description, sitio, areas = [], ordenCtas, noindex = false, schema = [] } = Astro.props;
const mensajeWhatsapp = Astro.props.mensajeWhatsapp ?? sitio.mensajeWhatsappPorDefecto;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Una imagen para compartir por sitio (public/og.jpg, 1200×630): WhatsApp y redes la muestran al pegar el enlace.
const ogImagen = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!indexar || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={sitio.colorTema} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={estudio.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--fuente-titulos" preload />
    <Font cssVariable="--fuente-texto" preload />
    <JsonLd datos={legalService({ site: Astro.site, sitio, areas, sitioHermano })} />
    {schema.map((datos) => <JsonLd datos={datos} />)}
    {analitica && <script is:inline defer src="/_vercel/insights/script.js"></script>}
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Sprite />
    <Header sitio={sitio} areas={areas} mensajeWhatsapp={mensajeWhatsapp} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer sitio={sitio} areas={areas} />
    <BarraContactoMovil sitio={sitio} orden={ordenCtas} mensajeWhatsapp={mensajeWhatsapp} />
    <BotonWhatsAppFlotante mensaje={mensajeWhatsapp} ariaLabel={sitio.flotante.aria} titulo={sitio.flotante.titulo} />
  </body>
</html>

<style>
  @media (max-width: 47.99em) {
    body {
      padding-bottom: calc(var(--alto-barra) + env(safe-area-inset-bottom));
    }
  }
  main:focus {
    outline: none;
  }
</style>
