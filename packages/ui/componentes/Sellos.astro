---
import Icono from './Icono.astro';

interface Props {
  items: { icono: string; texto: string }[];
  etiqueta?: string;
}
const { items, etiqueta = 'Por qué confiar en nosotros' } = Astro.props;
---

<ul class="sellos" role="list" aria-label={etiqueta}>
  {
    items.map((s) => (
      <li>
        <Icono nombre={s.icono} tamano={22} />
        <span>{s.texto}</span>
      </li>
    ))
  }
</ul>

<style>
  .sellos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--esp-4) var(--esp-5);
    padding-top: var(--esp-5);
    border-top: 1px solid var(--c-borde);
    font-size: var(--paso--1);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  li {
    display: flex;
    align-items: center;
    gap: var(--esp-3);
    line-height: 1.3;
  }
  li :global(.icono) {
    color: var(--c-icono);
  }
  @media (min-width: 48em) {
    .sellos {
      grid-template-columns: repeat(4, auto);
      justify-content: start;
      gap: var(--esp-6);
    }
  }
</style>
