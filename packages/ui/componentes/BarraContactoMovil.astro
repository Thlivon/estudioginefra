---
// Barra fija inferior (< 768 px): dos botones 50/50 en el orden del sitio.
import BotonContacto from './BotonContacto.astro';
import { botones } from '../enlaces.mjs';

interface Props {
  sitio: any;
  orden?: 'llamar-primero' | 'whatsapp-primero';
  mensajeWhatsapp?: string;
}
const { sitio, orden = sitio.ordenCtas, mensajeWhatsapp } = Astro.props;
---

<nav class="barra solo-movil" aria-label="Contacto rápido">
  {botones(sitio, 'barra', mensajeWhatsapp, orden).map((b) => <BotonContacto {...b} />)}
</nav>

<style>
  .barra {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--esp-2);
    padding: var(--esp-2) var(--esp-2) calc(var(--esp-2) + env(safe-area-inset-bottom));
    background: var(--tinta);
    border-top: 1px solid rgb(247 245 240 / 0.15);
    --c-texto: var(--papel);
  }
  .barra :global(.boton) {
    padding-inline: var(--esp-2);
  }
</style>
