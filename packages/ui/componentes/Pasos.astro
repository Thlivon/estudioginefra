---
// Proceso numerado. `corto`: columnas en desktop; `guia`: vertical, con texto largo.
interface Props {
  items: { titulo: string; texto: string }[];
  variante?: 'corto' | 'guia';
  nivelTitulo?: 'h2' | 'h3';
}
const { items, variante = 'corto', nivelTitulo: Titulo = 'h3' } = Astro.props;
---

<ol class:list={['pasos', `pasos--${variante}`]} role="list">
  {
    items.map((p, i) => (
      <li>
        <span class="pasos__numero" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <Titulo class="pasos__titulo">{p.titulo}</Titulo>
        <p>{p.texto}</p>
      </li>
    ))
  }
</ol>

<style>
  .pasos {
    display: grid;
    gap: var(--esp-6);
  }
  li {
    display: grid;
    align-content: start;
    gap: var(--esp-2);
    padding-top: var(--esp-4);
    border-top: 1px solid var(--c-borde);
  }
  .pasos__numero {
    font-family: var(--fuente-titulos);
    font-size: var(--paso-3);
    font-weight: 500;
    line-height: 1;
    color: var(--c-enlace);
    font-variant-numeric: lining-nums;
  }
  p {
    color: var(--c-suave);
  }
  @media (min-width: 48em) {
    .pasos--corto {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
    .pasos--guia li {
      grid-template-columns: 5rem 1fr;
      column-gap: var(--esp-5);
    }
    .pasos--guia .pasos__numero {
      grid-row: span 2;
    }
  }
</style>
