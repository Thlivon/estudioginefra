---
// Ícono del sprite propio (ver Sprite.astro). Decorativo: el texto accesible va en el elemento que lo contiene.
interface Props {
  nombre: string;
  tamano?: number;
  class?: string;
}
const { nombre, tamano = 24, class: clase } = Astro.props;
---

<svg
  class:list={['icono', clase]}
  width={tamano}
  height={tamano}
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"><use href={`#i-${nombre}`}></use></svg>

<style>
  .icono {
    flex: none;
  }
</style>
