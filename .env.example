# Variables de entorno. Los valores reales viven en Vercel (Settings > Environment Variables).
# En local no hace falta .env: los valores por defecto sirven para desarrollar.

# URL canónica. En Vercel se deriva sola de VERCEL_PROJECT_PRODUCTION_URL; solo para forzarla.
SITE_URL=http://localhost:4321

# true únicamente en producción real (estudioginefra.com.ar). En pruebas: false = noindex.
INDEXAR=false

# Formulario de contacto. false = solo WhatsApp y teléfonos (sin formulario, sin JS y /api/contacto/ responde 404).
# Se lee en el build (genera el formulario y /contacto/enviado/) y en runtime (el endpoint lo vuelve a chequear).
CONTACTO_EMAIL=false

# Envío del formulario por Resend (solo con CONTACTO_EMAIL=true).
# Sin clave: en local (astro dev) no envía y muestra el email en consola; en Vercel responde error.
RESEND_API_KEY=
# Casilla que recibe las consultas.
CONTACTO_DESTINO=estudiolosdefensores@hotmail.com
# Remitente verificado en Resend (p. ej. "Web Ginefra <consultas@estudioginefra.com.ar>"). Vacío = onboarding@resend.dev.
CONTACTO_REMITENTE=
